# Copy to backend/.env (loaded automatically) or export — every variable is optional; defaults are the local fallbacks.
# Model provider. Setting BACKBOARD_API_KEY selects Backboard (thread API, translated to chat completions; the
# openJiuwen agents reach it through the backend's /llm/v1 shim). LLM_MODEL is then the Backboard model_name
# (default gpt-4o) and BACKBOARD_LLM_PROVIDER its upstream (openai, anthropic, google, xai, openrouter).
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
# Otherwise any OpenAI-compatible endpoint (OpenRouter: https://openrouter.ai/api/v1 + sk-or key + e.g. openai/gpt-4o-mini;
# Baseten: base URL + key + model). Default: local Ollama. LLM_PROVIDER=openai-compatible forces this path when a
# Backboard key is also set.
LLM_PROVIDER=
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=600
CITYSHIFT_API_PORT=8000
CITYSHIFT_PACK_ROOT=
CITYSHIFT_STORAGE=mongodb
MONGODB_URI=
MONGODB_DATABASE=cityshift_events_development
MONGODB_TLS_CA_FILE=
# Evidence index. Local Elasticsearch by default; Elastic Cloud when both cloud vars are set.
ELASTIC_URL=http://localhost:9200
ELASTIC_CLOUD_URL=
ELASTIC_API_KEY=
# Error reporting (no-op without a DSN).
SENTRY_DSN=
# Public replay export via Cloudflare R2 (local zip export without these).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Frontend (frontend/.env.local): optional Mapbox Standard alternative at /mapbox.
# The default Babylon renderer at / and /world does not require a Mapbox token.
VITE_MAPBOX_TOKEN=
