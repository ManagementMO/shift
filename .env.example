# Copy to backend/.env (or export) — every variable is optional; defaults are the local fallbacks.
# Model provider (OpenAI-compatible). Default: local Ollama. Baseten: base URL + key + model name.
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=600
# Evidence index. Local Elasticsearch by default; Elastic Cloud when both cloud vars are set.
ELASTIC_URL=http://localhost:9200
ELASTIC_CLOUD_URL=
ELASTIC_API_KEY=
# Error reporting (no-op without a DSN).
SENTRY_DSN=
# Public replay export via Cloudflare R2 (local zip export without these).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Frontend (frontend/.env.local): Mapbox GL v3 Standard basemap; MapLibre + OpenFreeMap without it.
VITE_MAPBOX_TOKEN=
